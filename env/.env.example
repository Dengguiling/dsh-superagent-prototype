# ---------------------------------------------------------------------------
# dsh-superagent mock corporate development environment
#
# This is the template of env/.env: copy it to env/.env and keep it there
# (`cp env/.env.example env/.env`).  Every value is for a LOCAL mock
# environment only.
# ---------------------------------------------------------------------------

# ---- host ports -----------------------------------------------------------
REDMINE_PORT=3000
GERRIT_HTTP_PORT=8080
GERRIT_SSH_PORT=29418
PG_PORT=5432

# ---- the sign-in page (env/login/server.py) -------------------------------
# The host port of the sign-in page and the addresses it uses: the first two
# are the ones the browser gets, the third one is the address of Redmine
# inside the compose network.
SIGNIN_PORT=3001
SIGNIN_REDMINE_URL=http://localhost:3000
SIGNIN_GERRIT_URL=http://localhost:8080
SIGNIN_REDMINE_INTERNAL_URL=http://redmine:3000

# ---- PostgreSQL (backs Redmine) ------------------------------------------
REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine
REDMINE_DB_PASSWORD=redmine

# ---- Redmine --------------------------------------------------------------
# secret_key_base shared by the redmine and redmine-init containers so that
# sessions survive a restart of the stack.
REDMINE_SECRET_KEY_BASE=5b2f0a1c9d8e7f6a3b4c5d6e7f80912a3b4c5d6e7f8091a2b3c4d5e6f708192a

# Three roles, in both systems.  The administrator is the system manager: it
# keeps the highest rights and stays out of the tests.  The leader assigns the
# work and reviews the patches.  The developer takes the work; the superagent
# binds to the developer's account, so there is no account of the agent's own.
REDMINE_ADMIN_LOGIN=admin
REDMINE_ADMIN_PASSWORD=admin12345
# 40 hex chars, must match Redmine's api token format
REDMINE_ADMIN_API_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4
REDMINE_ADMIN_FIRSTNAME=System
REDMINE_ADMIN_LASTNAME=Administrator
REDMINE_ADMIN_MAIL=admin@example.com

# The leader: the project manager who assigns the defects to the developer.
REDMINE_LEAD_LOGIN=lead
REDMINE_LEAD_PASSWORD=lead12345
REDMINE_LEAD_API_KEY=1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d
REDMINE_LEAD_FIRSTNAME=Wang
REDMINE_LEAD_LASTNAME=Lei
REDMINE_LEAD_MAIL=lead@example.com

# The developer ("you"): the account the superagent binds to.  Older revisions
# of this environment created the account as `agent`; init.rb renames it once,
# keeping its user id and its API key, so the values below are the old ones.
REDMINE_DEV_LOGIN=dev
REDMINE_DEV_PASSWORD=agent12345
REDMINE_DEV_API_KEY=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c
REDMINE_DEV_FIRSTNAME=Zhang
REDMINE_DEV_LASTNAME=Wei
REDMINE_DEV_MAIL=dev@example.com
# The login the `agent` account had before the rename (init.rb only uses it to
# find the account when `dev` does not exist yet).
REDMINE_LEGACY_DEV_LOGIN=agent

# The old single-project demo, kept for compatibility.  seed.sh closes its
# issues so that the workbench only lists the SDK scenario.
REDMINE_PROJECT_ID=demo
REDMINE_PROJECT_NAME="Demo Project"

# The corporate scenario: the identifier of the Redmine project equals the
# name of the Gerrit repository, so the agent clones the repository of the
# issue's project.
REDMINE_SDK_PROJECT=sdk
REDMINE_SDK_PROJECT_NAME="Demo SDK"
REDMINE_SDK_CLI_PROJECT=sdk-cli
REDMINE_SDK_CLI_PROJECT_NAME="Demo SDK CLI"

# ---- Gerrit ---------------------------------------------------------------
GERRIT_CANONICAL_WEB_URL=http://localhost:8080/
GERRIT_ADMIN_LOGIN=admin
GERRIT_ADMIN_EMAIL=admin@example.com
GERRIT_ADMIN_PASSWORD=admin12345

# The leader: the team leader who reviews the patches and merges them.  The
# account is created by Gerrit's own HTTP login flow (see gerrit/start.sh):
# only that flow gives an account the external id that the HTTP authentication
# mode looks the user up by, so an account created over the REST API cannot be
# used in the browser.
GERRIT_LEAD_LOGIN=lead
GERRIT_LEAD_EMAIL=lead@example.com
GERRIT_LEAD_PASSWORD=lead12345

# The developer: the account the superagent pushes the patches with.  It is
# created over the REST API, which is enough for a push over SSH.
GERRIT_DEV_LOGIN=dev
GERRIT_DEV_EMAIL=dev@example.com
GERRIT_DEV_PASSWORD=dev12345
# The old compatibility project and the branch new patches are pushed to.
GERRIT_PROJECT=demo
GERRIT_BRANCH=main

# ---- Gerrit SSH key (the developer's account) -----------------------------
# Primary key used by seed.sh / verify.sh (ECDSA, works with every client).
GERRIT_SSH_KEY_FILE=keys/agent_id_ecdsa
# Alternative RSA key, also registered for the agent account.  Modern OpenSSH
# needs "-o PubkeyAcceptedAlgorithms=+ssh-rsa" for it.
GERRIT_SSH_KEY_FILE_RSA=keys/agent_id_rsa
